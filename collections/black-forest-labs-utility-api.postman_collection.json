  "info": {
    "_postman_id": "439b6ca7-4202-403a-84fb-d7c7c10ea61c",
    "name": "Black Forest Labs FLUX Editing Utility API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Asynchronous image generation API from Black Forest Labs. Submit a\ngeneration request to a model-specific endpoint and poll\n`/v1/get_result` (or use the optional webhook callback) for the\nfinished image. Includes the FLUX, FLUX.1, and FLUX.2 model families,\nFill/Expand image editing tools, credit lookup, and fine-tune\nmanagement.\n\n\nContact Support:\n Name: Black Forest Labs",
      "type": "text/plain"
    }
  }
